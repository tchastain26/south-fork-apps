# Security headers (added 2026.08.25, from the 2026.07.06 security review finding #1)
#
# CSP NOTE: 273 of 274 pages use inline <script> and all 274 use inline <style>.
# A blocking CSP with script-src 'self' would break the entire site, so the CSP
# below ships as Report-Only first. Review reports, then promote to enforcing.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Permissions-Policy: geolocation=(self), camera=(self), fullscreen=(self), clipboard-write=(self), microphone=(), payment=(), usb=(), serial=(), midi=(), magnetometer=(), gyroscope=(), accelerometer=(), browsing-topics=()
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://*.googlesyndication.com https://*.doubleclick.net https://*.google.com https://*.googletagservices.com https://*.adtrafficquality.google; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: blob: https:; connect-src 'self' https://generativelanguage.googleapis.com https://api.allorigins.win https://*.googlesyndication.com https://*.doubleclick.net https://*.google.com https://*.adtrafficquality.google https://*.gstatic.com; frame-src 'self' https://*.googlesyndication.com https://*.doubleclick.net https://*.google.com https://*.adtrafficquality.google; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'self'

# Embeds are meant to be framed by other sites, so this one path opts out of the
# sitewide framing ban. Everything else keeps X-Frame-Options: SAMEORIGIN.
# Only stateless calculators are published here (see build_embeds.py); nothing
# that stores personal data, reads location, or takes an API key.
# These pages carry no ads: serving Google ads inside a frame on a site we do
# not control is against AdSense policy, and every embed is noindex, which
# ads_update.py already treats as ad-ineligible.
/embed/*
  ! X-Frame-Options
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: frame-ancestors *; base-uri 'self'; form-action 'self'; object-src 'none'
  # Cloudflare appends same-named headers rather than replacing them, so simply
  # adding a second Report-Only policy left the restrictive one in force and
  # still logged a violation on every legitimate embed. Unset it instead; the
  # enforcing policy above is what governs this path.
  ! Content-Security-Policy-Report-Only
  Cache-Control: public, max-age=0, s-maxage=3600, must-revalidate

# Cache rules (unchanged)
/*.html
  Cache-Control: public, max-age=0, s-maxage=3600, must-revalidate

/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable

/*.xml
  Cache-Control: public, max-age=3600, s-maxage=3600

/*.txt
  Cache-Control: public, max-age=86400, s-maxage=86400
